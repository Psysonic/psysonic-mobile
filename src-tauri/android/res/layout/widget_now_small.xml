<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, small (PsysonicWidgets): cover, play button, title, artist, progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/PsyWidgetRoot"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/widget_toggle"
        style="@style/PsyWidgetPlayButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp" />
  </LinearLayout>

  <FrameLayout
      android:layout_width="1dp"
      android:layout_height="0dp"
      android:layout_weight="1" />

  <TextView
      android:id="@+id/widget_title"
      style="@style/PsyWidgetTitle"
      android:textSize="16sp"
      android:text="Psysonic" />

  <TextView
      android:id="@+id/widget_artist"
      style="@style/PsyWidgetSubtitle" />

  <ProgressBar
      android:id="@+id/widget_progress"
      style="@style/PsyWidgetProgress"
      android:layout_marginTop="10dp" />
</LinearLayout>
