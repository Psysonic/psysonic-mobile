<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, large (PsysonicWidgets): the medium widget plus the next three songs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/PsyWidgetRoot"
    android:orientation="vertical">

  <include layout="@layout/widget_now_player" />

  <ProgressBar
      android:id="@+id/widget_progress"
      style="@style/PsyWidgetProgress"
      android:layout_marginTop="10dp" />

  <TextView
      android:id="@+id/widget_next_label"
      style="@style/PsyWidgetTitle"
      android:layout_marginTop="14dp"
      android:textSize="15sp" />

  <LinearLayout
      android:id="@+id/widget_next_row_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_next_cover_1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

      <TextView
          android:id="@+id/widget_next_title_1"
          style="@style/PsyWidgetTitle"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/widget_next_artist_1"
          style="@style/PsyWidgetSubtitle"
          android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:id="@+id/widget_next_row_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_next_cover_2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

      <TextView
          android:id="@+id/widget_next_title_2"
          style="@style/PsyWidgetTitle"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/widget_next_artist_2"
          style="@style/PsyWidgetSubtitle"
          android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:id="@+id/widget_next_row_3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_next_cover_3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

      <TextView
          android:id="@+id/widget_next_title_3"
          style="@style/PsyWidgetTitle"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/widget_next_artist_3"
          style="@style/PsyWidgetSubtitle"
          android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
